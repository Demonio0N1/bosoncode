#!/usr/bin/env python3
# =============================================================================
# carpeta-share-descargas — servidor del modo "solo descarga".
#
# Lo lanza 'carpeta-share compartir <ruta> --descarga'; no se usa a mano.
# Cada enlace https://<host>/dl/<token> muestra una página con el nombre, el
# tamaño y un botón; la descarga en sí vive en /dl/<token>/<nombre>:
#   * archivo  → se descarga tal cual (reanudable con Range)
#   * carpeta  → se empaqueta en un .zip al vuelo (sin archivos temporales)
# Un enlace puede caducar, tener un máximo de descargas y pedir contraseña.
#
# Diseño de seguridad (el porqué de cada pieza):
#   * Escucha SOLO en 127.0.0.1: desde fuera únicamente se llega a través de
#     Tailscale Funnel, igual que el modo web.
#   * La URL solo lleva el token (y un nombre decorativo). Ninguna parte de
#     la petición se usa como ruta de archivo, así que no hay "../" que
#     valga: lo único descargable es lo que el anfitrión registró.
#   * Solo GET/HEAD, más un POST que únicamente lee la contraseña del
#     formulario (4 KB como mucho): no hay forma de subir ni modificar nada.
#   * La página intermedia evita que las vistas previas de los chats (que
#     abren cada enlace que ven) gasten una descarga de un enlace con límite.
#   * El estado se relee en cada petición: revocar un enlace (quitar su token
#     de estado.json) surte efecto al instante, sin reiniciar el servidor.
#   * Al comprimir una carpeta no se siguen enlaces simbólicos que apunten
#     fuera de ella y, salvo que el anfitrión lo pida, se dejan fuera los
#     archivos ocultos (.git, .env…).
#   * Se niega a correr como root: solo necesita leer lo que el anfitrión ya
#     puede leer.
# =============================================================================
import argparse
import hmac
import html
import json
import os
import socket
import sys
import threading
import time
import traceback
import urllib.parse
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MONTAJE = "dl"        # ruta pública; debe coincidir con MONTAJE_DESCARGAS del CLI
BLOQUE = 64 * 1024
MAX_FORMULARIO = 4096
INTENTOS_MAX, INTENTOS_VENTANA = 8, 600    # contraseñas fallidas por enlace cada 10 min

_candado = threading.Lock()

PAGINA = """<!doctype html>
<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{titulo}</title>
<style>
:root {{ color-scheme: light dark; --fondo: #f4f4f1; --tarjeta: #ffffff; --texto: #1c1c1a;
  --tenue: #65655f; --borde: #dcdcd5; --acento: #1558d6; --sobre: #ffffff; --error: #c62828; }}
@media (prefers-color-scheme: dark) {{ :root {{ --fondo: #151513; --tarjeta: #1f1f1c;
  --texto: #ecece6; --tenue: #a0a098; --borde: #34342f; --acento: #7ab0ff; --sobre: #0c1626; --error: #ff8a80; }} }}
body {{ margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--fondo);
  color: var(--texto); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }}
main {{ box-sizing: border-box; width: min(92vw, 26rem); padding: 1.75rem; background: var(--tarjeta);
  border: 1px solid var(--borde); border-radius: 14px; }}
h1 {{ margin: 0 0 .4rem; font-size: 1.15rem; overflow-wrap: anywhere; }}
p {{ margin: .3rem 0; color: var(--tenue); }}
p.error {{ color: var(--error); }}
.boton {{ display: block; box-sizing: border-box; width: 100%; margin-top: 1.25rem; padding: .8rem 1rem;
  border: 0; border-radius: 10px; background: var(--acento); color: var(--sobre); font: inherit;
  font-weight: 600; text-align: center; text-decoration: none; cursor: pointer; }}
input {{ box-sizing: border-box; width: 100%; margin-top: 1rem; padding: .7rem .8rem; border: 1px solid var(--borde);
  border-radius: 10px; background: transparent; color: inherit; font: inherit; }}
small {{ display: block; margin-top: 1.25rem; color: var(--tenue); font-size: .8rem; }}
</style></head><body><main>
{cuerpo}
<small>Compartido con carpeta-share. Este enlace solo permite descargar.</small>
</main></body></html>
"""


def registrar(*campos):
    # Una línea por petición en stdout: fecha|token[:8]|resultado|nombre|ip.
    # El CLI redirige esto a descargas.log.
    limpio = [str(c).replace("|", "/").replace("\n", " ").replace("\r", " ") for c in campos]
    with _candado:
        sys.stdout.write(time.strftime("%Y-%m-%d %H:%M:%S") + "|" + "|".join(limpio) + "\n")
        sys.stdout.flush()


def leer_descargas(ruta_estado):
    # El CLI reescribe estado.json de forma no atómica: si lo leemos a medias,
    # reintentamos un instante después. None = no se pudo leer.
    for _ in range(5):
        try:
            with open(ruta_estado) as f:
                return json.load(f).get("descargas", [])
        except ValueError:
            time.sleep(0.05)
        except OSError:
            break
    return None


def dentro(ruta, raiz):
    return ruta == raiz or ruta.startswith(raiz.rstrip(os.sep) + os.sep)


def nombre_de(ruta):
    return os.path.basename(ruta.rstrip(os.sep)) or "carpeta"


def tamano(b):
    for unidad in ("B", "KB", "MB", "GB"):
        if b < 1024:
            return ("%d %s" % (b, unidad)) if unidad == "B" else ("%.1f %s" % (b, unidad)).replace(".", ",")
        b /= 1024.0
    return ("%.1f TB" % b).replace(".", ",")


def restante(segundos):
    if segundos < 3600:
        return "%d min" % max(1, round(segundos / 60))
    if segundos < 172800:
        return "%d h" % round(segundos / 3600)
    return "%d días" % round(segundos / 86400)


def rango(cabecera, tam):
    # Un único rango "bytes=a-b", "bytes=a-" o "bytes=-n". Devuelve (inicio,
    # fin) inclusive, None para servir el archivo entero o "invalido" (416).
    if not cabecera or not cabecera.startswith("bytes=") or "," in cabecera:
        return None
    a, _, b = cabecera[6:].strip().partition("-")
    try:
        if a == "":
            if int(b) <= 0:
                return "invalido"
            return max(0, tam - int(b)), tam - 1
        inicio, fin = int(a), (int(b) if b else tam - 1)
    except ValueError:
        return None
    if inicio >= tam or inicio > fin:
        return "invalido"
    return inicio, min(fin, tam - 1)


class Usos:
    """Descargas completadas por token; este archivo lo escribe solo el servidor.

    Con límite (--max-descargas) cada descarga RESERVA un hueco al empezar y
    lo confirma al terminar entera; si se corta, lo libera. Así dos descargas
    simultáneas no pueden pasarse del límite y un corte de red no quema el
    enlace.
    """

    def __init__(self, ruta):
        self.ruta = ruta
        self.candado = threading.Lock()
        self.en_curso = {}
        try:
            with open(ruta) as f:
                self.datos = json.load(f)
        except (OSError, ValueError):
            self.datos = {}

    def _n(self, token):
        return int(self.datos.get(token, {}).get("n", 0))

    def usados(self, token):
        with self.candado:
            return self._n(token)

    def reservar(self, token, maximo):
        with self.candado:
            if self._n(token) + self.en_curso.get(token, 0) >= maximo:
                return False
            self.en_curso[token] = self.en_curso.get(token, 0) + 1
            return True

    def liberar(self, token):
        with self.candado:
            self.en_curso[token] = max(0, self.en_curso.get(token, 0) - 1)

    def confirmar(self, token, vigentes):
        # vigentes: tokens que siguen en estado.json (None si no se pudo leer);
        # de paso olvidamos los contadores de enlaces ya revocados.
        with self.candado:
            self.datos[token] = {"n": self._n(token) + 1, "ultima": time.strftime("%Y-%m-%d %H:%M")}
            if vigentes is not None:
                self.datos = {t: v for t, v in self.datos.items() if t in vigentes}
            tmp = self.ruta + ".tmp"
            with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
                json.dump(self.datos, f)
            os.replace(tmp, self.ruta)


class Intentos:
    """Freno a la fuerza bruta: contraseñas fallidas recientes por enlace."""

    def __init__(self):
        self.candado = threading.Lock()
        self.fallos = {}

    def bloqueado(self, token):
        ahora = time.time()
        with self.candado:
            self.fallos[token] = [t for t in self.fallos.get(token, []) if ahora - t < INTENTOS_VENTANA]
            return len(self.fallos[token]) >= INTENTOS_MAX

    def fallo(self, token):
        with self.candado:
            self.fallos.setdefault(token, []).append(time.time())


class Trozos:
    """Escritor HTTP "chunked": el zip no tiene tamaño conocido de antemano.

    Si algo falla a mitad no se envía el trozo final, y el navegador marca la
    descarga como fallida en lugar de dejar un zip truncado que parece entero.
    """

    def __init__(self, salida):
        self.salida = salida
        self.buf = bytearray()

    def write(self, datos):
        self.buf += datos
        if len(self.buf) >= BLOQUE:
            self.flush()
        return len(datos)

    def flush(self):
        if self.buf:
            self.salida.write(b"%X\r\n%b\r\n" % (len(self.buf), bytes(self.buf)))
            del self.buf[:]

    def terminar(self):
        self.flush()
        self.salida.write(b"0\r\n\r\n")


def recorrer(raiz, con_ocultos, omitidos=None):
    # Qué entra en el .zip de una carpeta: ("dir" | "archivo", ruta, nombre
    # dentro del zip). Los ocultos que se dejan fuera se anotan en `omitidos`.
    base = nombre_de(raiz)
    real = os.path.realpath(raiz)
    for carpeta, subdirs, archivos in os.walk(raiz):
        if not con_ocultos:
            if omitidos is not None:
                omitidos.extend(n for n in subdirs + archivos if n.startswith("."))
            subdirs[:] = [d for d in subdirs if not d.startswith(".")]
            archivos = [n for n in archivos if not n.startswith(".")]
        # os.walk no desciende por enlaces simbólicos; tampoco los listamos.
        subdirs[:] = sorted(d for d in subdirs if not os.path.islink(os.path.join(carpeta, d)))
        rel = os.path.relpath(carpeta, raiz)
        arc = base if rel == "." else os.path.join(base, rel)
        yield "dir", carpeta, arc       # entrada de directorio: conserva las carpetas vacías
        for n in sorted(archivos):
            p = os.path.join(carpeta, n)
            if os.path.islink(p) and not dentro(os.path.realpath(p), real):
                continue                # enlace simbólico hacia fuera de la carpeta
            if not os.path.isfile(p) or not os.access(p, os.R_OK):
                continue                # sockets, FIFOs, enlaces rotos, ilegibles
            yield "archivo", p, os.path.join(arc, n)


def empaquetar(raiz, salida, con_ocultos):
    # zipfile sabe escribir en un flujo sin seek (usa "data descriptors"), así
    # que la carpeta sale comprimida conforme se lee, sea del tamaño que sea.
    with zipfile.ZipFile(salida, "w", zipfile.ZIP_DEFLATED, strict_timestamps=False) as z:
        for _, ruta, arc in recorrer(raiz, con_ocultos):
            z.write(ruta, arc)


def medir(ruta, con_ocultos):
    # Para el CLI: "archivos|bytes|ocultos omitidos|ejemplos" de lo que se
    # entregaría, con las mismas reglas que usa el .zip.
    if not os.path.isdir(ruta):
        print("1|%d|0|" % os.path.getsize(ruta))
        return
    omitidos, n, total = [], 0, 0
    for clase, p, _ in recorrer(ruta, con_ocultos, omitidos):
        if clase == "archivo":
            n += 1
            try:
                total += os.path.getsize(p)
            except OSError:
                pass
    print("%d|%d|%d|%s" % (n, total, len(omitidos), ", ".join(sorted(set(omitidos))[:4])))


class Descargas(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "carpeta-share"
    sys_version = ""
    timeout = 300

    def do_GET(self):
        self.atender()

    def do_HEAD(self):
        self.atender()

    def do_POST(self):
        self.atender()

    def version_string(self):
        return self.server_version

    def log_message(self, formato, *args):
        pass  # el registro lo llevamos nosotros, sin tokens completos

    def buscar(self):
        # → (enlace o None, tokens vigentes o None, ¿es la URL de descarga?)
        partes = [p for p in urllib.parse.urlsplit(self.path).path.split("/") if p]
        # Tailscale recorta el prefijo de montaje antes de reenviar; aceptamos
        # la ruta con o sin él.
        if partes and partes[0] == MONTAJE:
            partes = partes[1:]
        descargas = leer_descargas(self.server.estado)
        vigentes = None if descargas is None else {str(d.get("token", "")) for d in descargas}
        if partes:
            token = partes[0].encode()
            for d in descargas or []:
                if hmac.compare_digest(str(d.get("token", "")).encode(), token):
                    return d, vigentes, len(partes) > 1
        return None, vigentes, False

    def comunes(self):
        self.send_header("Connection", "close")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Robots-Tag", "noindex, nofollow")
        self.send_header("Referrer-Policy", "no-referrer")

    def pagina(self, estado, titulo, cuerpo):
        datos = PAGINA.format(titulo=html.escape(titulo), cuerpo=cuerpo).encode()
        self.send_response(estado)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(datos)))
        self.send_header(
            "Content-Security-Policy",
            "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'",
        )
        self.comunes()
        self.end_headers()
        self.respondiendo = True
        if self.command != "HEAD":
            self.wfile.write(datos)

    def no_disponible(self, estado, motivo):
        # Token inexistente y revocado responden igual: no damos pistas.
        self.pagina(estado, "Enlace no disponible", "<h1>Enlace no disponible</h1><p>%s</p>" % html.escape(motivo))

    def destino(self, token, descarga):
        # Relativo a /dl/<token>: funciona igual detrás del prefijo de Funnel.
        return html.escape(urllib.parse.quote(token, safe="") + "/" + urllib.parse.quote(descarga, safe=""))

    def pagina_clave(self, estado, token, error=""):
        # Sin la contraseña no revelamos ni el nombre ni el tamaño (por eso
        # el formulario apunta a un nombre genérico; el real llega después,
        # en Content-Disposition).
        cuerpo = "<h1>Descarga protegida</h1><p>Escribe la contraseña que te enviaron.</p>"
        if error:
            cuerpo += '<p class="error">%s</p>' % html.escape(error)
        cuerpo += (
            '<form method="post" action="%s">'
            '<input type="password" name="clave" placeholder="Contraseña" autocomplete="off" autofocus required>'
            '<button class="boton" type="submit">Descargar</button></form>' % self.destino(token, "descarga")
        )
        self.pagina(estado, "Descarga protegida", cuerpo)

    def pagina_info(self, d, token, ruta, descarga, es_dir):
        if es_dir:
            detalle = "Carpeta comprimida (.zip)"
            if d.get("archivos") is not None and d.get("tamano") is not None:
                n = int(d["archivos"])
                detalle += " · %d archivo%s · %s sin comprimir" % (n, "" if n == 1 else "s", tamano(int(d["tamano"])))
        else:
            detalle = "Archivo · " + tamano(os.path.getsize(ruta))
        cuerpo = "<h1>%s</h1><p>%s</p>" % (html.escape(descarga), html.escape(detalle))
        if d.get("expira"):
            cuerpo += "<p>Caduca en %s</p>" % restante(d["expira"] - time.time())
        if d.get("max"):
            q = int(d["max"]) - self.server.usos.usados(token)
            cuerpo += "<p>%s</p>" % ("Queda 1 descarga" if q == 1 else "Quedan %d descargas" % q)
        cuerpo += '<a class="boton" href="%s" download>Descargar</a>' % self.destino(token, descarga)
        self.pagina(200, descarga, cuerpo)

    def leer_clave(self):
        try:
            n = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            n = 0
        if n <= 0 or n > MAX_FORMULARIO:
            return ""
        campos = urllib.parse.parse_qs(self.rfile.read(n).decode("utf-8", "replace"), keep_blank_values=True)
        return campos.get("clave", [""])[0]

    def iniciar_descarga(self, nombre, tipo, estado=200):
        simple = "".join(c if 32 <= ord(c) < 127 and c not in '"\\' else "_" for c in nombre)
        self.send_response(estado)
        self.send_header("Content-Type", tipo)
        self.send_header(
            "Content-Disposition",
            "attachment; filename=\"%s\"; filename*=UTF-8''%s" % (simple, urllib.parse.quote(nombre, safe="")),
        )
        self.comunes()
        self.respondiendo = True

    def enviar_archivo(self, ruta, con_cuerpo, con_rangos):
        # → True si la respuesta llegó hasta el último byte del archivo.
        with open(ruta, "rb") as f:
            st = os.fstat(f.fileno())
            tam = st.st_size
            etag = '"%x-%x"' % (st.st_mtime_ns, tam)
            inicio, fin, parcial = 0, tam - 1, False
            if con_rangos and tam > 0:
                r = rango(self.headers.get("Range"), tam)
                if r == "invalido":
                    self.send_response(416)
                    self.send_header("Content-Range", "bytes */%d" % tam)
                    self.send_header("Content-Length", "0")
                    self.comunes()
                    self.end_headers()
                    self.respondiendo = True
                    return False
                # If-Range: si el archivo cambió desde el primer intento, se
                # manda entero en vez de pegar trozos de dos versiones.
                if r and self.headers.get("If-Range", etag) == etag:
                    inicio, fin = r
                    parcial = True
            self.iniciar_descarga(nombre_de(ruta), "application/octet-stream", 206 if parcial else 200)
            if con_rangos:
                self.send_header("Accept-Ranges", "bytes")
                self.send_header("ETag", etag)
            if parcial:
                self.send_header("Content-Range", "bytes %d-%d/%d" % (inicio, fin, tam))
            pendiente = fin - inicio + 1
            self.send_header("Content-Length", str(pendiente))
            self.end_headers()
            if not con_cuerpo:
                return False
            f.seek(inicio)
            while pendiente > 0:
                trozo = f.read(min(BLOQUE, pendiente))
                if not trozo:
                    raise OSError("el archivo se acortó durante la descarga")
                self.wfile.write(trozo)
                pendiente -= len(trozo)
            return fin == tam - 1

    def enviar_zip(self, ruta, descarga, con_cuerpo, con_ocultos):
        os.listdir(ruta)    # si no se puede leer, que falle antes de responder 200
        self.iniciar_descarga(descarga, "application/zip")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        if not con_cuerpo:
            return False
        salida = Trozos(self.wfile)
        empaquetar(ruta, salida, con_ocultos)
        salida.terminar()
        return True

    def atender(self):
        self.close_connection = True    # una petición por conexión: simple y suficiente
        self.respondiendo = False
        srv = self.server
        con_cuerpo = self.command != "HEAD"
        ip = self.headers.get("X-Forwarded-For", self.client_address[0])[:60]
        d, vigentes, directo = self.buscar()
        if d is None:
            self.no_disponible(404, "Este enlace no es válido o fue revocado.")
            return
        token, ruta = str(d.get("token", "")), str(d.get("ruta", ""))
        ficha, nombre = token[:8], nombre_de(ruta)
        maximo, clave = int(d.get("max") or 0), str(d.get("contrasena") or "")
        if d.get("expira") and time.time() >= d["expira"]:
            self.no_disponible(410, "Este enlace caducó. Pide uno nuevo a quien te lo envió.")
            return
        if maximo and srv.usos.usados(token) >= maximo:
            self.no_disponible(410, "Este enlace ya alcanzó su número máximo de descargas.")
            return
        es_dir = os.path.isdir(ruta)
        if not es_dir and not os.path.isfile(ruta):
            self.no_disponible(404, "Este enlace no es válido o fue revocado.")
            registrar(ficha, "falta", nombre, ip)
            return
        descarga = nombre + ".zip" if es_dir else nombre

        if clave:
            if self.command != "POST":
                self.pagina_clave(403 if directo else 200, token)
                return
            if srv.intentos.bloqueado(token):
                self.no_disponible(429, "Demasiados intentos fallidos. Espera unos minutos y vuelve a probar.")
                registrar(ficha, "bloqueado", nombre, ip)
                return
            if not hmac.compare_digest(clave.encode(), self.leer_clave().encode()):
                srv.intentos.fallo(token)
                self.pagina_clave(403, token, "Contraseña incorrecta.")
                registrar(ficha, "clave-mala", nombre, ip)
                return
        elif not directo:
            self.pagina_info(d, token, ruta, descarga, es_dir)
            return

        # A partir de aquí es una descarga de verdad.
        reservado = False
        if maximo and con_cuerpo:
            if not srv.usos.reservar(token, maximo):
                self.no_disponible(409, "Alguien está descargando este enlace ahora mismo. Prueba en unos minutos.")
                return
            reservado = True
        try:
            if es_dir:
                completa = self.enviar_zip(ruta, descarga, con_cuerpo, bool(d.get("ocultos", True)))
            else:
                # Reanudar solo tiene sentido en enlaces sin límite ni
                # contraseña: con límite, cada descarga debe ser una entera.
                completa = self.enviar_archivo(ruta, con_cuerpo, not maximo and not clave)
            if completa:
                srv.usos.confirmar(token, vigentes)
            registrar(ficha, "ok" if completa else ("parcial" if con_cuerpo else "head"), nombre, ip)
        except (ConnectionError, socket.timeout):
            registrar(ficha, "interrumpida", nombre, ip)
        except Exception:
            # Si ya empezamos a responder, cortar la conexión es la única
            # señal honesta de que la descarga no llegó entera.
            if not self.respondiendo:
                self.no_disponible(404, "Este enlace no es válido o fue revocado.")
            registrar(ficha, "error", nombre, ip)
            traceback.print_exc()
        finally:
            if reservado:
                srv.usos.liberar(token)


def main():
    ap = argparse.ArgumentParser(description="Servidor del modo solo descarga de carpeta-share.")
    ap.add_argument("--medir", metavar="RUTA", help="mide lo que se entregaría de RUTA y termina")
    ap.add_argument("--con-ocultos", action="store_true", help="con --medir: cuenta también los archivos ocultos")
    ap.add_argument("--estado", help="ruta de estado.json")
    ap.add_argument("--puerto", type=int, help="puerto local (solo loopback)")
    a = ap.parse_args()
    if a.medir:
        medir(a.medir, a.con_ocultos)
        return
    if not a.estado or not a.puerto:
        ap.error("faltan --estado y --puerto")
    if os.geteuid() == 0:
        sys.exit("carpeta-share-descargas no se ejecuta como root.")
    servidor = ThreadingHTTPServer(("127.0.0.1", a.puerto), Descargas)
    servidor.estado = a.estado
    servidor.usos = Usos(os.path.join(os.path.dirname(os.path.abspath(a.estado)), "descargas-usos.json"))
    servidor.intentos = Intentos()
    servidor.serve_forever()


if __name__ == "__main__":
    main()
