{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boson Server",
  "version": "1.0.1",
  "identifier": "com.garyguaman.bosonserver",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boson Server",
        "width": 960,
        "height": 640,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Boson Code",
    "shortDescription": "El servidor de BosonCode, con ventana",
    "longDescription": "Instala, configura y vigila el servidor de BosonCode en este equipo: Tailscale, claves, Claude Sessions Monitor y el editor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../setup.sh": "scripts/setup.sh",
      "../../serve.sh": "scripts/serve.sh",
      "../../csm": "scripts/csm",
      "../../linkspace": "scripts/linkspace",
      "../askpass.sh": "askpass.sh"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
